# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (see README for the local Docker value)
DATABASE_URL=

# debug | info | warn | error | silent (default: info)
LOG_LEVEL=

# AI workflow. AI_PROVIDER: mock (default, no key needed) | openai
AI_PROVIDER=
# Required when AI_PROVIDER=openai. Server-side only; never exposed to the browser.
OPENAI_API_KEY=
# Optional (default: gpt-4.1-mini). Must support Structured Outputs (json_schema).
OPENAI_MODEL=

# Optional: integration test database (defaults to DATABASE_URL's name + "_test"; must end in _test)
TEST_DATABASE_URL=
